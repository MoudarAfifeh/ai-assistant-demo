{
  "name": "my-app",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "bun run --cwd packages/server test",
    "dev": "concurrently --names server,client --prefix-colors cyan,green \"bun run --cwd packages/server dev\" \"bun run --cwd packages/client dev\"",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "concurrently": "^10.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "mariadb": "3.5.5"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "react-loading-skeleton": "^3.5.0"
  }
}
