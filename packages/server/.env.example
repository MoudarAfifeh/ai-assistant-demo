# Copy to .env and fill in real values. Never commit .env.

# OpenAI API key: used by the chatbot (gpt-4.1) and as the review-summary
# fallback (gpt-4o-mini) when OLLAMA_HOST is not set.
OPENAI_API_KEY=

# MySQL connection string used by Prisma (app + CLI).
# For a TLS database (e.g. Aiven), add ?sslcert=./ca.pem — relative paths
# resolve from the prisma/ folder. Optional: &sslaccept=accept_invalid_certs
DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/DATABASE

# Optional: Ollama host for local review summaries (e.g. http://127.0.0.1:11434).
# Leave unset to use OpenAI instead (required on Vercel).
OLLAMA_HOST=

# Optional: Upstash Redis for rate limiting the LLM endpoints (shared across
# Vercel serverless instances). The KV_REST_API_URL / KV_REST_API_TOKEN names
# set by Vercel's Upstash integration also work. If unset, an in-memory
# limiter is used (fine locally; per-instance only on Vercel).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: local server port (default 3000). The Vite dev proxy expects 3000.
PORT=

# Set automatically by Vercel; do not set locally.
# VERCEL=
